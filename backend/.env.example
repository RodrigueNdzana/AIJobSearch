DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobsearch
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
UPLOAD_DIR=./uploads/cvs
MAX_CV_SIZE_MB=5
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Password reset emails. Leave SMTP_HOST empty to log reset emails to the
# backend console instead of sending them (fine for local development).
# FRONTEND_BASE_URL is used to build the link inside the reset email —
# point it at wherever you're serving the frontend/ folder.
FRONTEND_BASE_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=ndzanarodrigue6@gmail.com
EMAIL_FROM_NAME=AI Jobline

# Cover letter drafting (used by both /api/applications/draft-cover-letter
# and the assistant's "draft an application for..." intent). Leave
# OPENAI_API_KEY empty to use the built-in template generator instead of a
# real LLM call - works with zero setup, same pattern as SMTP above.
OPENAI_API_KEY= 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
